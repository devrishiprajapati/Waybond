generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         String        @default("USER")
  profile      Json?
  joinedAt     DateTime      @default(now())
  lastLoginAt  DateTime      @updatedAt
  bookings     Booking[]
  testimonials Testimonial[]
  tickets      Ticket[]
}

model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN") // MASTER_ADMIN or ADMIN
  permissions  Json     @default("[]") // Array of permission strings
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String? // ID of the admin who created this user
  lastLoginAt  DateTime @default(now())

  @@index([email])
  @@index([role])
}

model Trip {
  id        Int      @id @default(autoincrement())
  payload   Json
  discount  Int?     @default(0) // Discount percentage (0-100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]
}

model HeroSlide {
  id        Int      @id @default(autoincrement())
  position  Int      @unique
  payload   Json
  updatedAt DateTime @updatedAt
}

model TrendingCard {
  id        Int      @id @default(autoincrement())
  position  Int      @unique
  payload   Json
  updatedAt DateTime @updatedAt
}

model PasswordResetOtp {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Payment {
  id                String   @id @default(cuid())
  bookingId         String
  userId            String
  amount            Int
  currency          String   @default("INR")
  razorpayOrderId   String   @unique
  razorpayPaymentId String?  @unique
  status            String   @default("CREATED")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([bookingId])
  @@index([userId])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  trip      String
  review    String
  rating    Int
  email     String?
  media     String?
  mediaType String?
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Booking {
  id        String   @id @default(cuid())
  userId    String
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tickets   Ticket[]

  @@index([userId])
}

model Ticket {
  id            String   @id @default(cuid())
  bookingId     String
  tripId        Int
  userId        String
  passengerName String
  ticketType    String
  fileUrl       String   @db.Text
  fileName      String
  mimeType      String
  uploadedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookingId, passengerName])
  @@index([tripId])
  @@index([userId])
  @@map("tickets")
}

model CommunityGallery {
  slug        String   @id
  destination String
  label       String
  images      Json
  updatedAt   DateTime @updatedAt
}

model TeamMember {
  id          Int      @id @default(autoincrement())
  name        String
  designation String
  shortBio    String
  fullBio     String   @db.Text
  image       String
  email       String?
  phone       String?
  linkedin    String?
  twitter     String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([position])
}

model PromoCode {
  id               String           @id @default(cuid())
  code             String           @unique
  discountType     String // PERCENTAGE or FIXED
  discountValue    Int // Percentage (0-100) or fixed amount in INR
  eligiblePackages Json // Array of trip IDs that this promo code applies to (empty array = all packages)
  minBookingAmount Int? // Minimum booking amount to use this promo
  maxDiscount      Int? // Maximum discount cap for percentage discounts
  validFrom        DateTime         @default(now())
  validUntil       DateTime
  usageLimit       Int? // Maximum number of times this code can be used (null = unlimited)
  usageCount       Int              @default(0)
  isActive         Boolean          @default(true)
  createdBy        String // Admin ID who created this promo code
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  description      String? // Optional description for admin reference
  usages           PromoCodeUsage[] // Relation to track all usages

  @@index([code])
  @@index([isActive])
  @@index([validUntil])
}

model PromoCodeUsage {
  id             String    @id @default(cuid())
  promoCodeId    String
  promoCode      PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  userId         String
  userName       String // Store user name for easy access
  userEmail      String // Store user email for easy access
  bookingId      String? // Reference to booking if available
  tripId         Int? // Which package was booked
  tripTitle      String? // Package title
  discountAmount Int // Actual discount amount applied
  bookingAmount  Int // Total booking amount
  finalAmount    Int // Amount after discount
  usedAt         DateTime  @default(now())

  @@index([promoCodeId])
  @@index([userId])
  @@index([usedAt])
  @@index([tripId])
}

model BookingReschedule {
  id              String    @id @default(cuid())
  bookingId       String
  userId          String
  fromTripId      Int
  fromTripTitle   String
  toTripId        Int
  toTripTitle     String
  fromPrice       Float
  toPrice         Float
  fromDeparture   String?
  toDeparture     String?
  priceDifference Float
  reason          String?
  status          String    @default("PENDING") // PENDING, APPROVED, COMPLETED, REJECTED
  requestedAt     DateTime  @default(now())
  processedAt     DateTime?
  processedBy     String?
  emailSent       Boolean   @default(false)
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([bookingId])
  @@index([userId])
  @@index([status])
}

model Enquiry {
  id           String   @id @default(cuid())
  name         String
  phone        String
  email        String?
  travelDate   String
  travellers   String
  message      String?  @db.Text
  tripTitle    String?
  tripLocation String?
  status       String   @default("NEW") // NEW, CONTACTED, IN_PROGRESS, CONVERTED, CLOSED
  notes        String?  @db.Text
  updatedBy    String? // Admin ID who last updated
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([phone])
}
