generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  passwordHash String
  role        String   @default("USER")
  profile     Json?
  joinedAt    DateTime @default(now())
  lastLoginAt DateTime @updatedAt
  bookings    Booking[]
  testimonials Testimonial[]
}

model Trip {
  id        Int      @id @default(autoincrement())
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HeroSlide {
  id        Int      @id @default(autoincrement())
  position  Int      @unique
  payload   Json
  updatedAt DateTime @updatedAt
}

model TrendingCard {
  id        Int      @id @default(autoincrement())
  position  Int      @unique
  payload   Json
  updatedAt DateTime @updatedAt
}

model PasswordResetOtp {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  trip      String
  review    String
  rating    Int
  email     String?
  media     String?
  mediaType String?
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Booking {
  id        String   @id @default(cuid())
  userId    String
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CommunityGallery {
  slug        String   @id
  destination String
  label       String
  images      Json
  updatedAt   DateTime @updatedAt
}
